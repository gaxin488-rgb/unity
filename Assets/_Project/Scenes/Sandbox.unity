  m_Script: {fileID: 11500000, guid: c166f5e21eece4d49bf04c3a5c15e34e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EchoesOfTheLost.Characters.NPCs.NPCController
  _npcId: npc_elder_maren
  _displayName: Elder Maren
  _portrait: {fileID: 0}
  _inkDialogueFile: {fileID: 0}
  _dialogueLines:
  - Welcome to the Verda Wilds, traveler. These Solenne ruins have slumbered for a thousand years.
  - Examine the glowing Echo Crystals nearby and clear out the Overgrown Guardians to uncover what happened here.
  _questToOfferId: quest_first_echo
  _questActiveLines:
  - The Echo Crystals still hum with ancient memories. Examine both crystals and defeat a Guardian.
  _questCompletedLines:
  - Incredible... So the Unraveling was triggered from the Citadel itself. Thank you, Kael.
  _schedule: []
  _hasSchedule: 1
  _interactRadius: 2.5
  _facesPlayerOnInteract: 1
  _relationshipLevel: 0
